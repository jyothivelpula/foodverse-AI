# Local defaults — put real secrets only in backend/.env (never commit them)
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/foodverse
# Supabase (for local scripts). On Render free tier use the POOLER URI, not Direct:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# How to get the correct Supabase URI for Render:
# 1. Open your CURRENT project in Supabase (check the URL: *.supabase.co/project/<ref>)
# 2. Click Connect → Connection string → Type: URI → Method: Session pooler
# 3. Copy the full string (username must be postgres.<that-same-ref>)
# 4. Paste as DATABASE_URL on Render → Save → Manual Deploy
# 5. /health must show database_host with that same project ref and database:"ok"
